NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/hotelpro
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:5000/api/v1/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: used by `npm run seed` to create an admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345

# Email (optional - without SMTP_HOST, emails are only printed in the server console)
# Gmail example: smtp.gmail.com / 587 / your address / an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=HotelPro <your-email@gmail.com>

# Public URL of this server (used to build uploaded image links). Default: http://localhost:5000
SERVER_URL=http://localhost:5000

# Set to true to require a verified email before a guest can book (verification links are printed in the
# server console when SMTP is not configured)
REQUIRE_EMAIL_VERIFICATION=false

# Optional demo staff account created by `npm run seed`
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=ChangeMe12345

# Room images in production (optional). Without these, uploads are stored in server/uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
